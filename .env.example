# ===== comenta EU QUERO — configuração =====
# Copie para .env e preencha. Tutoriais passo a passo: https://comentaeuquero.com
# Só as quatro primeiras são obrigatórias. O resto tem padrão que serve pra quase todo mundo.

# --- Obrigatórias -----------------------------------------------------------

# Do painel da Meta (Casos de uso > Configuração da API com login do Instagram):
# use o "ID do app do Instagram" e a "Chave secreta do app do Instagram".
# Dá pra preencher também em Configurações no painel (a chave fica cifrada,
# veja CEQ_ENCRYPTION_KEY). Sem META_APP_SECRET a instância recusa todo evento da Meta.
META_APP_ID=
META_APP_SECRET=

# Invente um token qualquer (letras/números). Cole o MESMO valor no campo
# "Verificar token" do webhook no painel da Meta.
WEBHOOK_VERIFY_TOKEN=

# URL pública HTTPS onde este app está acessível, sem barra no final.
# Ex.: https://meudominio.com ou a URL do seu Cloudflare Tunnel.
BASE_URL=

# --- Acesso ao painel ---------------------------------------------------------

# Senha do painel. Se ficar vazia, o primeiro acesso em /instalar?t=<CEQ_SETUP_TOKEN>
# cria a senha (guardada com hash no banco). Se preenchida, ela vence.
ADMIN_PASSWORD=
CEQ_SETUP_TOKEN=

# Chave que cifra no banco o App Secret e outros segredos salvos pelo painel.
# Gere uma com:  python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde essa chave fora do servidor: sem ela os segredos cifrados não abrem.
CEQ_ENCRYPTION_KEY=

# Deixe vazio em produção. Com 1, o painel aceita acesso por HTTP puro mesmo fora
# de localhost (saída de emergência pra proxy que não manda X-Forwarded-Proto).
CEQ_PERMITE_HTTP=

# --- Dados e retenção (LGPD) --------------------------------------------------

# Pasta do banco SQLite. No Docker já é /data (volume): não ligue. Fora dele o padrão é ./data.
# (Linhas comentadas abaixo: deixe assim a menos que precise; vazio sobrescreveria o padrão.)
# DATA_DIR=

# 0 ou vazio = guarda pra sempre.
# RETENCAO_LEADS_DIAS apaga o lead parado há mais tempo que isso, junto com as
# etiquetas e os campos que ele informou (telefone, e-mail).
RETENCAO_LEADS_DIAS=
# Log técnico (quem interagiu, o que chegou, o que foi enviado).
RETENCAO_EVENTOS_DIAS=

# --- Travas de segurança e envio ------------------------------------------------

# Teto de respostas por hora da instância (padrão 180; o limite da Meta é 750).
# Também dá pra mudar ao vivo em Configurações.
CEQ_ENVIOS_HORA=
# Quantas respostas de IA a mesma pessoa pode gerar por hora; passou disso, ela
# recebe o texto reserva do nó, sem gastar sua chave. Padrão 10.
CEQ_IA_POR_LEAD_HORA=
# Quantas senhas erradas, somando todos os IPs, o login aceita a cada 10 minutos
# antes de travar pra todo mundo. Padrão 30.
CEQ_LOGIN_FALHAS_JANELA=

# --- Nó de IA (opcional) ----------------------------------------------------------

# Chave da API da Anthropic. Sem ela o nó de IA responde com o texto reserva.
AI_API_KEY=
# Modelo padrão do nó (cada nó pode escolher o seu). Padrão: claude-haiku-4-5-20251001
# AI_MODEL=

# --- Alerta no Telegram (opcional) ----------------------------------------------

# Avisa quando a conta desconecta, o token está pra vencer ou a Meta limita os envios.
# Também dá pra configurar em Configurações no painel (o painel vence o .env).
ALERTA_TELEGRAM_TOKEN=
ALERTA_TELEGRAM_CHAT=

# --- Comunidade e atualização automática (opcional) ---------------------------------

# Token de assinante (membros do Push Club). Só informa o status no painel e liga o
# ping de atualização; nunca bloqueia a ferramenta. Quem usa por conta própria deixa vazio.
CLUB_TOKEN=
# Endereços do serviço de ativação. Só mude se hospedar o seu próprio.
# ACTIVATION_URL=
# CHAO_URL=
# Preenchida pelo instalador automático; não edite à mão.
# CHAO_VERSAO=

# Conector MCP (Claude): hosts extras, separados por vírgula, pra onde o login OAuth
# pode devolver o acesso. Padrão: claude.ai, claude.com e localhost.
# CEQ_MCP_REDIRECTS=
